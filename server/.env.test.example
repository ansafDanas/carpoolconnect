# Test environment for the server suite. Copy to .env.test and adjust:
#
#   cp .env.test.example .env.test
#
# .env.test is gitignored and is loaded automatically by `npm test`
# (see the "test" script in package.json, which passes --env-file=.env.test).
#
# ---------------------------------------------------------------------------
# A local MongoDB must be running and reachable at MONGO_TEST_URI.
# The suite talks to a real database on purpose: it exercises real queries,
# unique indexes and aggregation, so there are no in-memory or mocked
# substitutes. Point this at a database dedicated to testing -- the suite
# creates and drops records freely.
# ---------------------------------------------------------------------------

# Required. The test suite reads this in tests/setup.js and connects directly
# to it. The port is the MongoDB default; the database name should be a
# throwaway one that holds no application data.
MONGO_TEST_URI=mongodb://127.0.0.1:27017/carpoolconnect_test_codex

# Required. tests/setup.js throws immediately if this is unset, because the
# app signs real JWTs. Any non-empty value works for local testing. Use a
# throwaway placeholder, never a production secret.
JWT_SECRET=replace_with_any_local_test_only_value

# Required. Keeps the app in test mode, which stops server.js from opening a
# listening socket when the suite imports it. vitest.config.js also sets this.
NODE_ENV=test

# Optional, defaults to false. When "true", the database named in
# MONGO_TEST_URI is dropped after the run. Convenient locally; keep it false if
# you want to inspect the data a failed run left behind.
DROP_TEST_DATABASE=true

# ---------------------------------------------------------------------------
# Deliberately NOT set here
# ---------------------------------------------------------------------------
# EXPOSE_RESET_TOKEN_IN_RESPONSE is enabled by vitest.config.js for the suite
# only, so the password-reset flow can be tested without a mail server. Do not
# set it in this file.
#
# No SMTP, Cloudinary or CORS settings are needed: transactional mail is
# skipped when SMTP is unconfigured, and the CORS tests set CORS_ORIGINS
# themselves before importing the app.
#
# MONGO_URI is intentionally absent. It belongs to the running application,
# not to the test suite, and pointing the tests at application data risks
# destroying it.