PORT=5000
NODE_ENV=production
MONGO_URI=your_production_mongodb_connection_string
JWT_SECRET=replace_with_a_long_random_secret
CORS_ORIGINS=https://your-frontend-domain.example

# Public origin of the React app. Password reset links are built from this
# value; it is never taken from the incoming request. Defaults to
# http://localhost:5173 if unset.
CLIENT_URL=https://your-frontend-domain.example

# Never set this outside local development and the test suite. When it is
# exactly "true", POST /api/auth/forgot-password returns the real reset link in
# the response body so the flow can be exercised without a mail server.
EXPOSE_RESET_TOKEN_IN_RESPONSE=false

CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Nodemailer transport used for password reset mail.
SMTP_HOST=your_smtp_host
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
EMAIL_FROM=your_sender_email@example.com

# Test-only; do not configure these in production.
MONGO_TEST_URI=
VITEST=
